{
  "name": "salesforce-tests",
  "displayName": "Salesforce Tests",
  "version": "0.2.1",
  "description": "Salesforce test suite integrated with your Salesforce org.",
  "categories": [
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "testing",
    "development",
    "debugging"
  ],
  "publisher": "femartinezg",
  "author": {
    "name": "Fernando Martinez",
    "url": "https://github.com/femartinezg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/femartinezg/salesforce-tests"
  },
  "engines": {
    "vscode": "^1.122.0"
  },
  "main": "./out/src/extension.js",
  "icon": "images/icon128bg.png",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension executes Salesforce CLI commands using workspace configuration."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "salesforce-tests.runTestClass",
        "title": "Run Test Class",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(run)"
      },
      {
        "command": "salesforce-tests.clearTestRuns",
        "title": "Clear Test Runs",
        "category": "Salesforce Tests",
        "icon": "$(clear-all)"
      },
      {
        "command": "salesforce-tests.rerunTest",
        "title": "Rerun Test",
        "category": "Salesforce Tests",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "salesforce-tests.rerunLastTest",
        "title": "Rerun Last Test",
        "category": "Salesforce Tests",
        "enablement": "hasLastTestRuns && !apexTestsLoading",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "salesforce-tests.pinClass",
        "title": "Pin Class",
        "category": "Salesforce Tests",
        "icon": "$(pin)"
      },
      {
        "command": "salesforce-tests.unpinClass",
        "title": "Unpin Class",
        "category": "Salesforce Tests",
        "icon": "$(unpin)"
      },
      {
        "command": "salesforce-tests.refreshOrg",
        "title": "Refresh Org",
        "enablement": "!statusLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.refreshApexTests",
        "title": "Refresh Apex Tests",
        "enablement": "view == apexTestsTreeView && !apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.refreshCodeCoverage",
        "title": "Refresh Code Coverage",
        "enablement": "view == codeCoverageTreeView && !codeCoverageLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.clearCodeCoverage",
        "title": "Clear Code Coverage",
        "enablement": "!codeCoverageLoading && !codeCoverageClearing",
        "category": "Salesforce Tests",
        "icon": "$(clear-all)"
      },
      {
        "command": "salesforce-tests.findTest",
        "title": "Find",
        "enablement": "view == apexTestsTreeView && !apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(search)"
      },
      {
        "command": "salesforce-tests.findClass",
        "title": "Find",
        "enablement": "view == codeCoverageTreeView && !codeCoverageLoading",
        "category": "Salesforce Tests",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfTests",
          "title": "Salesforce Tests",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "sfTests": [
        {
          "id": "statusTreeView",
          "name": "Status",
          "icon": "$(beaker)",
          "initialSize": 1
        },
        {
          "id": "apexTestsTreeView",
          "name": "Apex Tests",
          "icon": "$(beaker)",
          "initialSize": 4
        },
        {
          "id": "codeCoverageTreeView",
          "name": "Code Coverage",
          "icon": "$(beaker)",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "statusTreeView",
        "contents": "Loading..."
      },
      {
        "view": "apexTestsTreeView",
        "contents": "Loading..."
      },
      {
        "view": "codeCoverageTreeView",
        "contents": "Loading..."
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "salesforce-tests.pinClass",
          "when": "false"
        },
        {
          "command": "salesforce-tests.unpinClass",
          "when": "false"
        },
        {
          "command": "salesforce-tests.clearTestRuns",
          "when": "false"
        },
        {
          "command": "salesforce-tests.rerunTest",
          "when": "false"
        },
        {
          "command": "salesforce-tests.rerunLastTest",
          "when": "hasLastTestRuns"
        }
      ],
      "view/title": [
        {
          "command": "salesforce-tests.refreshOrg",
          "when": "view == statusTreeView",
          "group": "navigation"
        },
        {
          "command": "salesforce-tests.rerunLastTest",
          "when": "view == apexTestsTreeView",
          "group": "navigation@1"
        },
        {
          "command": "salesforce-tests.refreshApexTests",
          "when": "view == apexTestsTreeView",
          "group": "navigation@2"
        },
        {
          "command": "salesforce-tests.refreshCodeCoverage",
          "when": "view == codeCoverageTreeView",
          "group": "navigation"
        },
        {
          "command": "salesforce-tests.clearCodeCoverage",
          "when": "view == codeCoverageTreeView",
          "group": "navigation"
        },
        {
          "command": "salesforce-tests.findTest",
          "when": "view == apexTestsTreeView",
          "group": "navigation@3"
        },
        {
          "command": "salesforce-tests.findClass",
          "when": "view == codeCoverageTreeView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "salesforce-tests.refreshOrg",
          "when": "view == statusTreeView && viewItem == statusOrg",
          "group": "inline"
        },
        {
          "command": "salesforce-tests.pinClass",
          "when": "view == apexTestsTreeView && viewItem == apexTestClass",
          "group": "inline@1"
        },
        {
          "command": "salesforce-tests.unpinClass",
          "when": "view == apexTestsTreeView && viewItem == pinnedApexTestClass",
          "group": "inline@1"
        },
        {
          "command": "salesforce-tests.pinClass",
          "when": "view == codeCoverageTreeView && viewItem == apexCoverageClass",
          "group": "inline@1"
        },
        {
          "command": "salesforce-tests.unpinClass",
          "when": "view == codeCoverageTreeView && viewItem == pinnedApexCoverageClass",
          "group": "inline@1"
        },
        {
          "command": "salesforce-tests.runTestClass",
          "when": "view == apexTestsTreeView",
          "group": "inline@2"
        },
        {
          "command": "salesforce-tests.clearTestRuns",
          "when": "view == statusTreeView && viewItem == statusLastTestRuns",
          "group": "inline"
        },
        {
          "command": "salesforce-tests.rerunTest",
          "when": "view == statusTreeView && viewItem == statusTestRun",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src test",
    "lint:tests": "eslint test",
    "check": "npm run compile && npm run lint && npm run test:extension",
    "test": "npm run test:extension",
    "test:extension": "vscode-test --jobs 1",
    "test:coverage": "npm run compile && vscode-test --jobs 1 --coverage"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.122.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "3.5.3",
    "sinon": "^22.1.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "cross-spawn": "7.0.6"
  }
}
