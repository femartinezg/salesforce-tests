{
  "name": "salesforce-tests",
  "displayName": "Salesforce Tests",
  "version": "0.2.1",
  "description": "Salesforce test suite integrated with your Salesforce org.",
  "categories": [
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "sf cli",
    "apex",
    "testing",
    "test explorer",
    "code coverage",
    "development",
    "debugging"
  ],
  "publisher": "femartinezg",
  "author": {
    "name": "Fernando Martinez",
    "url": "https://github.com/femartinezg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/femartinezg/salesforce-tests"
  },
  "homepage": "https://github.com/femartinezg/salesforce-tests#readme",
  "bugs": {
    "url": "https://github.com/femartinezg/salesforce-tests/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "main": "./out/src/extension.js",
  "icon": "images/icon128bg.png",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "salesforce-tests.runTestClass",
        "title": "Run Test Class",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(run)"
      },
      {
        "command": "salesforce-tests.runTestMethod",
        "title": "Run Test Method",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(run)"
      },
      {
        "command": "salesforce-tests.runTestSuite",
        "title": "Run Test Suite",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(run)"
      },
      {
        "command": "salesforce-tests.rerunTest",
        "title": "Rerun Last Test",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "salesforce-tests.runSelectedTests",
        "title": "Run Selected Tests",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(run-all)"
      },
      {
        "command": "salesforce-tests.rerunFailedTests",
        "title": "Rerun Failed Tests",
        "enablement": "!apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "salesforce-tests.refreshOrg",
        "title": "Refresh Org",
        "enablement": "!statusLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.refreshApexTests",
        "title": "Refresh Apex Tests",
        "enablement": "view == apexTestsTreeView && !apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.refreshCodeCoverage",
        "title": "Refresh Code Coverage",
        "enablement": "view == codeCoverageTreeView && !codeCoverageLoading",
        "category": "Salesforce Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "salesforce-tests.findTest",
        "title": "Find",
        "enablement": "view == apexTestsTreeView && !apexTestsLoading",
        "category": "Salesforce Tests",
        "icon": "$(search)"
      },
      {
        "command": "salesforce-tests.findClass",
        "title": "Find",
        "enablement": "view == codeCoverageTreeView && !codeCoverageLoading",
        "category": "Salesforce Tests",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfTests",
          "title": "Salesforce Tests",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "sfTests": [
        {
          "id": "statusTreeView",
          "name": "Status",
          "icon": "$(beaker)",
          "initialSize": 1
        },
        {
          "id": "apexTestsTreeView",
          "name": "Apex Tests",
          "icon": "$(beaker)",
          "initialSize": 4
        },
        {
          "id": "codeCoverageTreeView",
          "name": "Code Coverage",
          "icon": "$(beaker)",
          "initialSize": 2
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "statusTreeView",
        "contents": "Loading..."
      },
      {
        "view": "apexTestsTreeView",
        "contents": "Loading..."
      },
      {
        "view": "codeCoverageTreeView",
        "contents": "Loading..."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "salesforce-tests.runSelectedTests",
          "when": "view == apexTestsTreeView",
          "group": "navigation@1"
        },
        {
          "command": "salesforce-tests.rerunTest",
          "when": "view == statusTreeView",
          "group": "navigation@1"
        },
        {
          "command": "salesforce-tests.refreshOrg",
          "when": "view == statusTreeView",
          "group": "navigation@2"
        },
        {
          "command": "salesforce-tests.refreshApexTests",
          "when": "view == apexTestsTreeView",
          "group": "navigation@2"
        },
        {
          "command": "salesforce-tests.rerunFailedTests",
          "when": "view == apexTestsTreeView",
          "group": "navigation@3"
        },
        {
          "command": "salesforce-tests.refreshCodeCoverage",
          "when": "view == codeCoverageTreeView",
          "group": "navigation"
        },
        {
          "command": "salesforce-tests.findTest",
          "when": "view == apexTestsTreeView",
          "group": "navigation"
        },
        {
          "command": "salesforce-tests.findClass",
          "when": "view == codeCoverageTreeView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "salesforce-tests.refreshOrg",
          "when": "view == statusTreeView && viewItem == statusOrg",
          "group": "inline"
        },
        {
          "command": "salesforce-tests.runTestClass",
          "when": "view == apexTestsTreeView && viewItem == apexTestClass",
          "group": "inline"
        },
        {
          "command": "salesforce-tests.runTestMethod",
          "when": "view == apexTestsTreeView && viewItem == apexTestMethod",
          "group": "inline"
        },
        {
          "command": "salesforce-tests.runTestSuite",
          "when": "view == apexTestsTreeView && viewItem == apexTestSuite",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src test",
    "package:check": "vsce ls",
    "test:org": "npm run compile && node --test out/test/org/*.test.js",
    "test:unit": "npm run compile && node --test out/test/unit/*.test.js",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "3.5.3",
    "typescript": "^5.8.3"
  }
}
